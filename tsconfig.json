{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@lets-explain/core/*": ["./packages/core/src/*"],
      "@lets-explain/kafka": ["./courses/kafka/src/index.ts"],
      "@lets-explain/git": ["./courses/git/src/index.ts"],
      "@lets-explain/rabbitmq": ["./courses/rabbitmq/src/index.ts"],
      "@lets-explain/docker": ["./courses/docker/src/index.ts"],
      "@lets-explain/cicd": ["./courses/cicd/src/index.ts"],
      "@lets-explain/websocket": ["./courses/websocket/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "courses/*/src", "site/src"]
}
